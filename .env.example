# --- Core -----------------------------------------------------------------
# NODE_ENV is set by the scripts (vite dev / build / start). Do not set it here:
# Vite reads .env and would build development React.
# Public origin, used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL=http://localhost:3000
DATABASE_URL=postgres://olive:olive@localhost:5432/olive
# Without Docker: `pnpm db:local` runs an embedded Postgres (PGlite) instead. Use
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
#   DATABASE_POOL_MAX=1
# DATABASE_POOL_MAX=10

# Long random string (at least 32 chars). Used to hash IPs and phone numbers
# for rate limiting and review verification. Generate: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# --- First admin (seeded once; forced to change password on first login) -
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now-please

# Optional, development only: WhatsApp number the seed writes to settings so the
# WhatsApp buttons can be previewed. Leave empty in production; set it in the admin.
# SEED_WHATSAPP_NUMBER=

# --- File storage ---------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=8

# --- Optional: new-order notifications -----------------------------------
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# NOTIFY_EMAIL_FROM=orders@example.com
# ORDER_WEBHOOK_URL=https://example.com/hooks/new-order

# --- Optional: Cloudflare Turnstile on public forms ----------------------
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: privacy-friendly analytics --------------------------------
# ANALYTICS_PROVIDER=plausible   # plausible | umami
# ANALYTICS_DOMAIN=example.ma
# ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# UMAMI_WEBSITE_ID=

# --- Reverse proxy ------------------------------------------------------
# true only when the app runs behind your own proxy (nginx, Caddy) that sets
# X-Forwarded-For; otherwise clients could fake their IP for rate limiting.
# TRUST_PROXY=true
